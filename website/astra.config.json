{
  "docs": ".",
  "output": "dist-docs",
  "deploy": "cloudflare",
  "title": "endor.mbt",
  "base": "/",
  "trailingSlash": true,
  "exclude": [
    "node_modules",
    "dist-docs",
    "islands",
    "target",
    "_build",
    "README.md"
  ],
  "islands": {
    "dir": "public/islands",
    "basePath": "/islands/"
  },
  "headSnippets": [
    "<link rel=\"stylesheet\" href=\"/endor-demo.css\">"
  ],
  "cssUtilities": {
    "enabled": true,
    "split": true
  },
  "nav": [
    { "text": "Guide", "link": "/guide/" },
    { "text": "Cookbook", "link": "/cookbook/" },
    { "text": "Reference", "link": "/reference/" }
  ],
  "sidebar": "auto",
  "navigation": {
    "spa": true,
    "viewTransitions": false,
    "keyboard": true
  },
  "theme": {
    "socialLinks": [
      { "icon": "github", "link": "https://github.com/poteto0/endor.mbt" }
    ],
    "footer": {
      "message": "Released under the MIT License.",
      "copyright": "Copyright 2025 poteto0",
      "links": [
        {
          "title": "Docs",
          "items": [
            { "label": "Getting started", "href": "/guide/getting-started/" },
            { "label": "Cookbook", "href": "/cookbook/" },
            { "label": "Reference", "href": "/reference/" },
            { "label": "Versioning", "href": "/reference/versioning/" }
          ]
        },
        {
          "title": "Project",
          "items": [
            { "label": "GitHub", "href": "https://github.com/poteto0/endor.mbt" },
            { "label": "mooncakes.io", "href": "https://mooncakes.io/docs/poteto0/endor" },
            { "label": "Changelog", "href": "https://github.com/poteto0/endor.mbt/blob/main/CHANGELOG.md" }
          ]
        },
        {
          "title": "More",
          "items": [
            { "label": "MoonBit", "href": "https://www.moonbitlang.com/" },
            { "label": "EIP-1193", "href": "https://eips.ethereum.org/EIPS/eip-1193" }
          ]
        }
      ]
    }
  },
  "ogp": {
    "siteUrl": "https://endor.poteto-mahiro.com/",
    "twitterCard": "summary"
  }
}
