import {
  // aliased: this package is itself `env`. The read is per backend in *there*
  // — `process.env` on `js`, `getenv` on `native`, an import on `wasm` — which
  // is why nothing here has to be.
  "moonbitlang/core/env" @core_env,
}

// The suite's configuration, and nothing else. Its own package because both
// backends need it and neither should need the other: `backend/anvil` installs
// a fake wallet, `backend/http` exists to prove nothing has to be installed —
// so the second must not import the first merely to learn a URL.
//
// No `supported_targets`: reading an environment variable is not a browser
// thing, and the one package that fabricates a wallet is `backend/anvil`.
