import {
  "poteto0/endor/backend",
  "poteto0/endor/backend/env",
  // aliased: this package is itself `http`, and two `@http` cannot coexist
  "poteto0/endor/provider/http" @rpc,
  "poteto0/endor/provider/http/endpoint",
}

// Every backend `provider/http/endpoint` reaches, which is every one but
// `wasm-gc`. Nothing here is `js`: it fakes no wallet — that is the point of
// this backend — so it imports neither `ffi/js` nor `backend/anvil`, whose
// `js.mbt` installs one, and `backend/env` reads the URL portably. The suite
// that drives it still runs on `js`, because `backend/anvil` must.

supported_targets = "+js +native +wasm"
