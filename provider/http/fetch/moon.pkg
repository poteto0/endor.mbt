import {
  "poteto0/endor/provider",
  "poteto0/endor/provider/http",
  "poteto0/endor/ffi/js",
  "moonbitlang/core/string",
}

// Inherited from `ffi/js`: the HTTP client this transport is, is the browser's
// (and Node's) `fetch`. `provider/http` itself stays backend-agnostic — this
// package is the one that pins a backend, which is the whole point of the
// `HttpTransport` seam.

supported_targets = "js"
