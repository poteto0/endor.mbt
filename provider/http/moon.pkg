import {
  "poteto0/endor/provider",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/async",
} for "test"

// No `supported_targets`, and no FFI: the JSON-RPC framing is pure MoonBit, so
// it builds on every backend `types` does — `wasm-gc` included, which is the
// one `provider/http/endpoint` cannot reach because the HTTP client it uses has
// no implementation there. A host that supplies its own HTTP implements
// `HttpTransport` and still gets a provider.
